# PS-F03 Backend Environment Variables
# Copy this file to .env and fill in real values.
# DO NOT commit .env — it is gitignored.

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
# PostgreSQL (async) connection string.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Provisioned by Akshaya (infra/akshaya branch).
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/syntrax_ps_f03

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
# FastAPI/Uvicorn listen port. Default: 8000.
PORT=8000

# Environment tag: development | staging | production
ENVIRONMENT=development

# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
# Informal API key for internal service-to-service calls during dev.
# TBD: Replace with real auth mechanism before demo if required.
INTERNAL_API_KEY=changeme-dev-only

# ──────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# Example: http://localhost:3000,https://syntrax.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Demo / Seeding
# ──────────────────────────────────────────────────────────────
# If set to true, seed_demo_data.py will re-create demo fixtures on startup.
SEED_ON_STARTUP=false

